{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/schemas/r10-project-agent-1.json",
  "title": "R10 full-project storyboard Agent hub",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "project_name",
    "runtime_version",
    "workflow_revision",
    "agent_mode",
    "created_at",
    "updated_at",
    "linked_shared_files",
    "policy",
    "capability_registry",
    "project_state",
    "work_orders",
    "change_requests",
    "deliverables",
    "decision_log",
    "capability_gaps",
    "version_history",
    "human_signoffs",
    "counters"
  ],
  "not": {"required": ["runtime_test_certificates"]},
  "properties": {
    "schema_version": {"const": "R10-PROJECT-AGENT-1"},
    "project_id": {"type": "string", "minLength": 1},
    "project_name": {"type": "string", "minLength": 1},
    "runtime_version": {"const": "V16.3-148-R10-StableRuntime"},
    "workflow_revision": {"const": "R10-PG1"},
    "agent_mode": {"const": "full_safe"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "linked_shared_files": {
      "type": "object",
      "required": ["issue_ledger_title", "project_hub_title"]
    },
    "policy": {
      "type": "object",
      "required": [
        "plan_only_never_mutates",
        "preserve_previous_version",
        "explicit_scope_required_for_destructive_change",
        "max_internal_repair_rounds",
        "impact_regression_required",
        "human_signoff_required_for_archive",
        "formal_rule_auto_mutation",
        "unavailable_capability_must_be_recorded",
        "compact_master_version",
        "background_seedance_generation",
        "production_audit_separation_required",
        "repair_activation_condition",
        "repair_returns_to_independent_audit",
        "scene_draft_preflight_required",
        "failed_draft_learning_required",
        "first_draft_correctness_threshold_percent",
        "first_draft_direct_usability_threshold_percent",
        "max_new_local_issue_rate_percent",
        "minimum_episode_correctness_percent",
        "known_issue_recurrence_tolerance",
        "systemic_root_cause_tolerance"
      ],
      "properties": {
        "plan_only_never_mutates": {"const": true},
        "preserve_previous_version": {"const": true},
        "explicit_scope_required_for_destructive_change": {"const": true},
        "max_internal_repair_rounds": {"const": 3},
        "impact_regression_required": {"const": true},
        "human_signoff_required_for_archive": {"const": true},
        "formal_rule_auto_mutation": {"const": false},
        "unavailable_capability_must_be_recorded": {"const": true},
        "compact_master_version": {"const": "0.5.5"},
        "background_seedance_generation": {"const": false},
        "production_audit_separation_required": {"const": true},
        "repair_activation_condition": {"const": "independent_audit_fail_and_explicit_authorization"},
        "repair_returns_to_independent_audit": {"const": true},
        "scene_draft_preflight_required": {"const": true},
        "failed_draft_learning_required": {"const": true},
        "first_draft_correctness_threshold_percent": {"const": 98.0},
        "first_draft_direct_usability_threshold_percent": {"const": 98.0},
        "max_new_local_issue_rate_percent": {"const": 2.0},
        "minimum_episode_correctness_percent": {"const": 96.0},
        "known_issue_recurrence_tolerance": {"const": 0},
        "systemic_root_cause_tolerance": {"const": 0}
      }
    },
    "capability_registry": {"type": "object"},
    "project_state": {"$ref": "#/$defs/project_state"},
    "work_orders": {"type": "array", "items": {"$ref": "#/$defs/work_order"}},
    "change_requests": {"type": "array", "items": {"$ref": "#/$defs/change_request"}},
    "deliverables": {"type": "array"},
    "decision_log": {"type": "array"},
    "capability_gaps": {"type": "array"},
    "version_history": {"type": "array"},
    "human_signoffs": {"type": "array"},
    "handoffs": {"type": "array", "items": {"$ref": "#/$defs/handoff_manifest"}},
    "performance_traces": {"type": "array", "items": {"$ref": "#/$defs/stage_timing_trace"}},
    "repair_packages": {"type": "array", "items": {"$ref": "#/$defs/immutable_repair_package"}},
    "counters": {"type": "object"}
  },
  "$defs": {
    "quality_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "first_draft_quality": {
      "type": "object",
      "required": [
        "grade",
        "checked_shot_count",
        "issue_point_count",
        "unique_affected_shot_count",
        "affected_shot_ids",
        "first_draft_correctness_percent",
        "direct_usability_percent",
        "new_local_issue_shot_rate_percent",
        "episode_correctness_percent",
        "minimum_episode_correctness_percent",
        "hard_or_major_issue_count",
        "global_blocking_issue_count",
        "known_recurrence_count",
        "known_recurrence_pattern_keys",
        "systemic_duplicate_count",
        "systemic_pattern_keys",
        "commit_eligible",
        "final_independent_audit_required_percent",
        "threshold_met",
        "final_audit_pass"
      ],
      "properties": {
        "grade": {"enum": ["A", "B", "C"]},
        "checked_shot_count": {"type": "integer", "minimum": 0},
        "issue_point_count": {"type": "integer", "minimum": 0},
        "unique_affected_shot_count": {"type": "integer", "minimum": 0},
        "affected_shot_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "first_draft_correctness_percent": {"$ref": "#/$defs/quality_percentage"},
        "direct_usability_percent": {"$ref": "#/$defs/quality_percentage"},
        "new_local_issue_shot_rate_percent": {"$ref": "#/$defs/quality_percentage"},
        "episode_correctness_percent": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/quality_percentage"}
        },
        "minimum_episode_correctness_percent": {"$ref": "#/$defs/quality_percentage"},
        "hard_or_major_issue_count": {"type": "integer", "minimum": 0},
        "global_blocking_issue_count": {"type": "integer", "minimum": 0},
        "known_recurrence_count": {"type": "integer", "minimum": 0},
        "known_recurrence_pattern_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "systemic_duplicate_count": {"type": "integer", "minimum": 0},
        "systemic_pattern_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "commit_eligible": {"type": "boolean"},
        "final_independent_audit_required_percent": {"const": 100.0},
        "threshold_met": {"type": "boolean"},
        "final_audit_pass": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "production_quality_block": {
      "type": "object",
      "required": [
        "active",
        "reason",
        "grade",
        "artifact_id",
        "audit_cycle_id",
        "required_action",
        "created_at"
      ],
      "properties": {
        "active": {"type": "boolean"},
        "reason": {"const": "first_draft_quality_below_threshold"},
        "grade": {"enum": ["B", "C"]},
        "artifact_id": {"type": "string", "minLength": 1},
        "audit_cycle_id": {"type": "string", "minLength": 1},
        "required_action": {"const": "repair_root_cause_and_revalidate_prevention_gate"},
        "created_at": {"type": "string", "minLength": 1},
        "cleared_at": {"type": "string", "minLength": 1},
        "cleared_by_audit_cycle_id": {"type": "string", "minLength": 1},
        "cleared_by_artifact_id": {"type": "string", "minLength": 1},
        "cleared_by_certificate_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"active": {"const": false}},
            "required": ["active"]
          },
          "then": {
            "required": [
              "cleared_at",
              "cleared_by_audit_cycle_id",
              "cleared_by_artifact_id",
              "cleared_by_certificate_id"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "project_state": {
      "type": "object",
      "required": [
        "current_stage",
        "authoritative_sources",
        "latest_artifacts",
        "current_episode",
        "locked_story_range",
        "characters",
        "scenes",
        "props",
        "open_decisions",
        "blocked_scopes",
        "production_quality_block",
        "latest_first_draft_quality",
        "active_prevention_profile_sha256"
      ],
      "properties": {
        "current_stage": {"type": "string", "minLength": 1},
        "authoritative_sources": {"type": "array"},
        "latest_artifacts": {"type": "object"},
        "current_episode": {"type": ["string", "integer", "null"]},
        "locked_story_range": {"type": ["object", "array", "string", "null"]},
        "characters": {"type": "object"},
        "scenes": {"type": "object"},
        "props": {"type": "object"},
        "open_decisions": {"type": "array"},
        "blocked_scopes": {"type": "array"},
        "production_quality_block": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/production_quality_block"}
          ]
        },
        "latest_first_draft_quality": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/first_draft_quality"}
          ]
        },
        "active_prevention_profile_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        }
      }
    },
    "work_order": {
      "type": "object",
      "required": [
        "work_order_id",
        "timestamp",
        "window_key",
        "request_text",
        "operation",
        "mode",
        "targets",
        "source_lock",
        "protected_scope",
        "expected_outputs",
        "authorization",
        "server_actor_role",
        "server_window_binding_id",
        "server_actor_binding_id",
        "transport_session_fingerprint",
        "status",
        "internal_round",
        "validation",
        "deliverable_ids"
      ],
      "properties": {
        "server_actor_role": {"enum": ["production", "independent_audit", "repair"]},
        "server_window_binding_id": {"type": "string", "minLength": 1},
        "server_actor_binding_id": {"type": "string", "minLength": 1},
        "transport_session_fingerprint": {"type": ["string", "null"]}
      }
    },
    "handoff_manifest": {
      "type": "object",
      "required": [
        "handoff_id",
        "work_order_id",
        "audit_cycle_id",
        "logical_artifact_id",
        "handoff_type",
        "created_at",
        "from_window_role",
        "to_window_role",
        "scope",
        "fingerprints",
        "objective_evidence",
        "producer_claims",
        "cache_manifest",
        "stage_trace_id",
        "status"
      ],
      "properties": {
        "handoff_id": {"type": "string", "minLength": 1},
        "work_order_id": {"type": "string", "minLength": 1},
        "audit_cycle_id": {"type": "string", "minLength": 1},
        "logical_artifact_id": {"type": "string", "minLength": 1},
        "handoff_type": {"enum": ["production_to_audit", "audit_to_repair", "repair_to_audit", "audit_intake"]},
        "created_at": {"type": "string", "minLength": 1},
        "from_window_role": {"enum": ["external_input", "production", "independent_audit", "repair"]},
        "to_window_role": {"enum": ["production", "independent_audit", "repair"]},
        "scope": {
          "type": "object",
          "required": ["target_ids", "source_range", "boundary_context", "protected_scope"],
          "properties": {
            "target_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "source_range": {"type": "object", "minProperties": 1},
            "boundary_context": {
              "type": "object",
              "required": ["previous_end", "current_start", "current_end", "next_start"]
            },
            "protected_scope": {"type": "array", "items": {"type": "string"}}
          }
        },
        "fingerprints": {
          "type": "object",
          "required": [
            "source_bytes",
            "normalized_source",
            "episode_boundary",
            "artifact_raw",
            "artifact_semantic",
            "canonical",
            "parser",
            "schema",
            "runtime",
            "rules",
            "validator",
            "scripts",
            "dependencies_environment",
            "project_anchors",
            "target_model_contract"
          ],
          "properties": {
            "source_bytes": {"$ref": "#/$defs/sha256"},
            "normalized_source": {"$ref": "#/$defs/sha256"},
            "episode_boundary": {"$ref": "#/$defs/sha256"},
            "artifact_raw": {"$ref": "#/$defs/sha256"},
            "artifact_semantic": {"$ref": "#/$defs/sha256"},
            "canonical": {"$ref": "#/$defs/sha256"},
            "parser": {"$ref": "#/$defs/sha256"},
            "schema": {"$ref": "#/$defs/sha256"},
            "runtime": {"$ref": "#/$defs/sha256"},
            "rules": {"$ref": "#/$defs/sha256"},
            "validator": {"$ref": "#/$defs/sha256"},
            "scripts": {"$ref": "#/$defs/sha256"},
            "dependencies_environment": {"$ref": "#/$defs/sha256"},
            "project_anchors": {"$ref": "#/$defs/sha256"},
            "target_model_contract": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "objective_evidence": {
          "type": "object",
          "required": ["source_manifest", "workbook_manifest", "canonical_ref", "approved_locks", "deterministic_statistics"],
          "properties": {
            "source_manifest": {"type": "object", "minProperties": 1},
            "workbook_manifest": {"type": "object", "minProperties": 1},
            "canonical_ref": {"type": "string", "minLength": 1},
            "approved_locks": {"type": "object", "minProperties": 1},
            "deterministic_statistics": {"type": "object", "minProperties": 1}
          }
        },
        "producer_claims": {
          "type": "object",
          "required": ["claim_type", "chapter_map", "source_mapping", "protected_dialogue", "cognition_matrix", "scene_state", "shot_plan", "coverage", "preflight_findings"],
          "properties": {
            "claim_type": {"enum": ["production_claim", "audit_issue_baseline", "repair_result", "external_input_claim"]},
            "chapter_map": {"type": ["object", "array"]},
            "source_mapping": {"type": ["object", "array"]},
            "protected_dialogue": {"type": "array"},
            "cognition_matrix": {"type": "array"},
            "scene_state": {"type": "array"},
            "shot_plan": {"type": "array"},
            "coverage": {"type": "object"},
            "preflight_findings": {"type": "array"}
          }
        },
        "audit_certificate_id": {"type": "string", "minLength": 1},
        "previous_audit_certificate_id": {"type": "string", "minLength": 1},
        "previous_audit_certificate_hmac": {"$ref": "#/$defs/sha256"},
        "previous_audit_event_sha256": {"$ref": "#/$defs/sha256"},
        "production_stage_trace_id": {"type": "string", "minLength": 1},
        "reaudit_kind": {"const": "independent_audit_successor"},
        "reaudit_root_handoff_id": {"type": "string", "minLength": 1},
        "reaudit_parent_handoff_id": {"type": "string", "minLength": 1},
        "reaudit_sequence": {"type": "integer", "minimum": 1},
        "reaudit_route_trace_id": {"type": "string", "minLength": 1},
        "reaudit_event_trace_id": {"type": "string", "minLength": 1},
        "claim_authority_work_order_id": {"type": "string", "minLength": 1},
        "reaudit_audit_window_binding_id": {"type": "string", "minLength": 1},
        "reaudit_audit_actor_binding_id": {"type": "string", "minLength": 1},
        "reaudit_audit_session_fingerprint": {
          "anyOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "server_minted_lineage": {"const": true},
        "reaudit_lineage_sha256": {"$ref": "#/$defs/sha256"},
        "claimed_by_work_order_id": {"type": "string", "minLength": 1},
        "claim_token": {"type": "string", "minLength": 1},
        "claim_generation": {"type": "integer", "minimum": 1},
        "claim_epoch_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 253402300799},
        "claim_lease_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "claim_lease_expires_at": {"type": "string", "minLength": 1},
        "claim_lease_expires_epoch_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 253402300799},
        "reaudit_preclaim_projection_sha256": {"$ref": "#/$defs/sha256"},
        "reaudit_prerelease_projection_sha256": {"$ref": "#/$defs/sha256"},
        "consumed_by_work_order_id": {"type": "string", "minLength": 1},
        "latest_audit_certificate_id": {"type": "string", "minLength": 1},
        "consumed_at": {"type": "string", "minLength": 1},
        "consumption_claim": {
          "type": "object",
          "required": [
            "claim_token", "claim_generation", "claim_epoch_seconds",
            "claim_lease_seconds", "claim_lease_expires_at",
            "claim_lease_expires_epoch_seconds"
          ],
          "properties": {
            "claim_token": {"type": "string", "minLength": 1},
            "claim_generation": {"type": "integer", "minimum": 1},
            "claim_epoch_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 253402300799},
            "claim_lease_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "claim_lease_expires_at": {"type": "string", "minLength": 1},
            "claim_lease_expires_epoch_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 253402300799}
          },
          "additionalProperties": false
        },
        "claim_history": {"type": "array"},
        "audit_certificate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "reaudit_count": {"type": "integer", "minimum": 0},
        "reaudited_at": {"type": "string", "minLength": 1},
        "immutable_repair_package_id": {"type": "string"},
        "return_to_audit_work_order_id": {"type": "string", "minLength": 1},
        "return_to_audit_window_binding_id": {"type": "string", "minLength": 1},
        "return_to_audit_actor_binding_id": {"type": "string", "minLength": 1},
        "return_to_audit_session_fingerprint": {"type": "string", "minLength": 1},
        "supersedes_handoff_id": {"type": "string", "minLength": 1},
        "superseded_by_handoff_id": {"type": "string", "minLength": 1},
        "superseded_at": {"type": "string", "minLength": 1},
        "superseded_reason": {"type": "string", "minLength": 1},
        "recovery_id": {"type": "string", "minLength": 1},
        "recovery_gap_id": {"type": "string", "minLength": 1},
        "recovery_work_order_id": {"type": "string", "minLength": 1},
        "recovery_trace_id": {"type": "string", "minLength": 1},
        "recovery_plan_sha256": {"$ref": "#/$defs/sha256"},
        "recovery_plan_item": {"type": "object", "minProperties": 1},
        "recovery_cache_status": {"enum": ["invalidated_and_reissued"]},
        "history_preserved": {"type": "boolean"},
        "cache_manifest": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["cache_class", "cache_key", "status", "dependency_fingerprints"],
            "properties": {
              "cache_class": {"enum": ["source_extract", "canonical_parse", "project_anchors", "runtime_test_certificate", "independent_audit_scope"]},
              "cache_key": {"type": "string", "minLength": 1},
              "status": {"enum": ["hit", "miss", "invalidated", "not_applicable"]},
              "reason": {"type": "string"},
              "dependency_fingerprints": {"type": "object"}
            }
          }
        },
        "stage_trace_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["prepared", "consuming", "verified", "rejected", "consumed", "superseded"]}
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {"required": ["reaudit_kind"]},
              {"required": ["reaudit_root_handoff_id"]},
              {"required": ["reaudit_parent_handoff_id"]},
              {"required": ["reaudit_sequence"]},
              {"required": ["reaudit_route_trace_id"]},
              {"required": ["reaudit_event_trace_id"]},
              {"required": ["previous_audit_certificate_id"]},
              {"required": ["previous_audit_certificate_hmac"]},
              {"required": ["previous_audit_event_sha256"]},
              {"required": ["reaudit_audit_window_binding_id"]},
              {"required": ["reaudit_audit_actor_binding_id"]},
              {"required": ["reaudit_audit_session_fingerprint"]},
              {"required": ["server_minted_lineage"]},
              {"required": ["reaudit_lineage_sha256"]},
              {"required": ["reaudit_preclaim_projection_sha256"]},
              {"required": ["reaudit_prerelease_projection_sha256"]},
              {"required": ["latest_audit_certificate_id"]},
              {"required": ["consumption_claim"]}
            ]
          },
          "then": {
            "required": [
              "reaudit_kind", "reaudit_root_handoff_id",
              "reaudit_parent_handoff_id", "reaudit_sequence",
              "reaudit_route_trace_id", "reaudit_event_trace_id",
              "production_stage_trace_id", "previous_audit_certificate_id",
              "previous_audit_certificate_hmac", "previous_audit_event_sha256",
              "claim_authority_work_order_id",
              "reaudit_audit_window_binding_id",
              "reaudit_audit_actor_binding_id",
              "reaudit_audit_session_fingerprint",
              "server_minted_lineage", "reaudit_lineage_sha256"
            ],
            "properties": {
              "to_window_role": {"const": "independent_audit"},
              "status": {"enum": ["prepared", "consuming", "consumed"]}
            },
            "allOf": [
              {
                "if": {"properties": {"status": {"const": "prepared"}}, "required": ["status"]},
                "then": {
                  "not": {
                    "anyOf": [
                      {"required": ["claimed_by_work_order_id"]},
                      {"required": ["claim_token"]},
                      {"required": ["claim_epoch_seconds"]},
                      {"required": ["claim_lease_seconds"]},
                      {"required": ["claim_lease_expires_at"]},
                      {"required": ["claim_lease_expires_epoch_seconds"]},
                      {"required": ["consumed_by_work_order_id"]},
                      {"required": ["audit_certificate_id"]},
                      {"required": ["latest_audit_certificate_id"]},
                      {"required": ["consumed_at"]},
                      {"required": ["consumption_claim"]}
                    ]
                  }
                }
              },
              {
                "if": {"properties": {"status": {"const": "consuming"}}, "required": ["status"]},
                "then": {
                  "required": [
                    "claimed_by_work_order_id", "claim_token",
                    "claim_generation", "claim_epoch_seconds",
                    "claim_lease_seconds", "claim_lease_expires_at",
                    "claim_lease_expires_epoch_seconds",
                    "reaudit_preclaim_projection_sha256"
                  ],
                  "not": {
                    "anyOf": [
                      {"required": ["consumed_by_work_order_id"]},
                      {"required": ["audit_certificate_id"]},
                      {"required": ["latest_audit_certificate_id"]},
                      {"required": ["consumed_at"]},
                      {"required": ["consumption_claim"]}
                    ]
                  }
                }
              },
              {
                "if": {"properties": {"status": {"const": "consumed"}}, "required": ["status"]},
                "then": {
                  "required": [
                    "consumed_by_work_order_id", "audit_certificate_id",
                    "latest_audit_certificate_id", "consumed_at",
                    "consumption_claim", "claim_generation",
                    "reaudit_preclaim_projection_sha256"
                  ],
                  "not": {
                    "anyOf": [
                      {"required": ["claimed_by_work_order_id"]},
                      {"required": ["claim_token"]},
                      {"required": ["claim_epoch_seconds"]},
                      {"required": ["claim_lease_seconds"]},
                      {"required": ["claim_lease_expires_at"]},
                      {"required": ["claim_lease_expires_epoch_seconds"]}
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "if": {"properties": {"handoff_type": {"const": "production_to_audit"}}, "required": ["handoff_type"]},
          "then": {"properties": {"from_window_role": {"const": "production"}, "to_window_role": {"const": "independent_audit"}}}
        },
        {
          "if": {"properties": {"handoff_type": {"const": "audit_to_repair"}}, "required": ["handoff_type"]},
          "then": {"properties": {"from_window_role": {"const": "independent_audit"}, "to_window_role": {"const": "repair"}}, "required": ["audit_certificate_id", "immutable_repair_package_id"]}
        },
        {
          "if": {"properties": {"handoff_type": {"const": "repair_to_audit"}}, "required": ["handoff_type"]},
          "then": {"properties": {"from_window_role": {"const": "repair"}, "to_window_role": {"const": "independent_audit"}}, "required": ["immutable_repair_package_id", "return_to_audit_work_order_id", "return_to_audit_window_binding_id", "return_to_audit_actor_binding_id", "return_to_audit_session_fingerprint"]}
        },
        {
          "if": {"properties": {"handoff_type": {"const": "audit_intake"}}, "required": ["handoff_type"]},
          "then": {"properties": {"from_window_role": {"const": "external_input"}, "to_window_role": {"const": "independent_audit"}}}
        },
        {
          "if": {"properties": {"status": {"const": "superseded"}}, "required": ["status"]},
          "then": {"required": ["superseded_by_handoff_id", "superseded_at", "recovery_id", "recovery_gap_id", "recovery_work_order_id", "recovery_trace_id", "recovery_plan_sha256", "history_preserved"]}
        }
      ]
    },
    "stage_timing_trace": {
      "type": "object",
      "required": ["trace_id", "window_role", "task_type", "measurement_scope", "unmeasured_stages", "started_at", "ended_at", "wall_duration_ms", "input_fingerprints", "legacy_generation_calls", "seedance_batches_generated", "model_authored_derived_chars", "stages"],
      "properties": {
        "trace_id": {"type": "string", "minLength": 1},
        "window_role": {"enum": ["production", "independent_audit", "repair"]},
        "task_type": {"enum": ["production_preflight", "independent_audit", "repair", "archive"]},
        "measurement_scope": {"const": "server_only"},
        "unmeasured_stages": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "input_payload_bytes": {"type": "integer", "minimum": 0},
        "output_payload_bytes": {"type": "integer", "minimum": 0},
        "affected_shot_count": {"type": "integer", "minimum": 0},
        "preserved_semantic_count": {"type": "integer", "minimum": 0},
        "legacy_generation_calls": {"const": 0},
        "seedance_batches_generated": {"const": 0},
        "model_authored_derived_chars": {"const": 0},
        "started_at": {"type": "string", "minLength": 1},
        "ended_at": {"type": "string", "minLength": 1},
        "wall_duration_ms": {"type": "integer", "minimum": 0},
        "input_fingerprints": {"type": "object", "minProperties": 1},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["stage", "started_at", "ended_at", "duration_ms", "tool_call_count", "source_character_count", "payload_bytes", "shot_count", "batch_count", "cache_status", "cache_reason", "retry_count", "error_status"],
            "properties": {
              "stage": {"enum": ["bootstrap_status", "source_read", "canonicalization", "delta_base_load", "delta_scope_check", "delta_merge", "materialization", "legacy_materialization", "export_projection", "planning", "generation", "validation", "repair", "export", "ledger_handoff"]},
              "started_at": {"type": ["string", "null"], "minLength": 1},
              "ended_at": {"type": ["string", "null"], "minLength": 1},
              "duration_ms": {"type": "integer", "minimum": 0},
              "tool_call_count": {"type": ["integer", "null"], "minimum": 0},
              "source_character_count": {"type": ["integer", "null"], "minimum": 0},
              "payload_bytes": {"type": ["integer", "null"], "minimum": 0},
              "shot_count": {"type": "integer", "minimum": 0},
              "batch_count": {"const": 0},
              "cache_status": {"enum": ["hit", "miss", "mixed", "not_applicable"]},
              "cache_reason": {"type": "string", "minLength": 1},
              "retry_count": {"type": ["integer", "null"], "minimum": 0},
              "error_status": {"enum": ["none", "recovered", "blocked"]},
              "parallel_group_id": {"type": "string"}
            }
          }
        }
      }
    },
    "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "change_operation": {
      "type": "object",
      "required": [
        "operation",
        "target_ids",
        "instruction",
        "authoritative_basis",
        "protected_scope"
      ],
      "properties": {
        "operation": {"enum": ["add", "modify", "delete", "replace", "merge", "split", "move"]}
      }
    },
    "immutable_repair_package": {
      "type": "object",
      "required": [
        "repair_package_id", "audit_certificate_id", "audit_event_id",
        "audit_to_repair_handoff_id", "production_handoff_id",
        "production_work_order_id", "production_window_binding_id",
        "production_actor_binding_id", "production_session_fingerprint", "audit_work_order_id",
        "audit_window_binding_id", "audit_actor_binding_id", "audit_session_fingerprint",
        "created_at", "expires_at", "status",
        "base_artifact_id", "base_canonical_sha256", "fingerprints",
        "authorized_scope", "protected_scope_hash", "issue_targets", "topology_fingerprint",
        "source_audit_handoff_id", "source_audit_event_trace_id",
        "source_audit_route_trace_id", "source_production_stage_trace_id"
      ],
      "properties": {
        "record_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "integrity_hmac": {"$ref": "#/$defs/sha256"},
        "repair_package_id": {"type": "string", "minLength": 1},
        "audit_certificate_id": {"type": "string", "minLength": 1},
        "audit_event_id": {"type": "string", "minLength": 1},
        "audit_to_repair_handoff_id": {"type": "string", "minLength": 1},
        "repair_to_audit_handoff_id": {"type": "string", "minLength": 1},
        "production_handoff_id": {"type": "string", "minLength": 1},
        "production_work_order_id": {"type": "string", "minLength": 1},
        "production_window_binding_id": {"type": "string", "minLength": 1},
        "production_actor_binding_id": {"type": "string", "minLength": 1},
        "production_session_fingerprint": {"type": "string", "minLength": 1},
        "audit_work_order_id": {"type": "string", "minLength": 1},
        "audit_window_binding_id": {"type": "string", "minLength": 1},
        "audit_actor_binding_id": {"type": "string", "minLength": 1},
        "audit_session_fingerprint": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "expires_at": {"type": "string", "minLength": 1},
        "status": {"enum": ["issued", "consuming", "consumed"]},
        "base_artifact_id": {"type": "string", "minLength": 1},
        "base_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "fingerprints": {"$ref": "#/$defs/handoff_manifest/properties/fingerprints"},
        "authorized_scope": {
          "type": "object",
          "required": ["shot_ids", "fields", "issue_codes"],
          "properties": {
            "shot_ids": {"type": "array", "items": {"type": "string"}},
            "fields": {"type": "array", "items": {"type": "string"}},
            "issue_codes": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        },
        "protected_scope_hash": {"$ref": "#/$defs/sha256"},
        "issue_targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["issue_id", "issue_code", "shot_id", "field", "location"],
            "properties": {
              "issue_id": {"type": "string", "minLength": 1},
              "issue_code": {"type": "string", "minLength": 1},
              "shot_id": {"type": "string", "minLength": 1},
              "field": {"type": "string", "minLength": 1},
              "location": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "topology_fingerprint": {"$ref": "#/$defs/sha256"},
        "consumed_by_work_order_id": {"type": "string", "minLength": 1},
        "successor_artifact_id": {"type": "string", "minLength": 1},
        "successor_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "source_audit_handoff_id": {"type": "string", "minLength": 1},
        "source_audit_event_trace_id": {"type": "string", "minLength": 1},
        "source_audit_route_trace_id": {"type": "string", "minLength": 1},
        "source_production_stage_trace_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "issued"}}, "required": ["status"]},
          "then": {
            "not": {
              "anyOf": [
                {"required": ["consumed_by_work_order_id"]},
                {"required": ["successor_artifact_id"]},
                {"required": ["successor_canonical_sha256"]},
                {"required": ["repair_to_audit_handoff_id"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "consuming"}}, "required": ["status"]},
          "then": {
            "required": ["consumed_by_work_order_id"],
            "not": {
              "anyOf": [
                {"required": ["successor_artifact_id"]},
                {"required": ["successor_canonical_sha256"]},
                {"required": ["repair_to_audit_handoff_id"]}
              ]
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "consumed"}}, "required": ["status"]},
          "then": {
            "required": [
              "consumed_by_work_order_id", "successor_artifact_id",
              "successor_canonical_sha256", "repair_to_audit_handoff_id"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "change_request": {
      "type": "object",
      "required": [
        "change_id",
        "work_order_id",
        "timestamp",
        "target_type",
        "target_file",
        "source_version",
        "operations",
        "required_downstream_updates",
        "authorization",
        "status"
      ],
      "properties": {
        "target_type": {"enum": ["script", "storyboard", "script_and_storyboard"]},
        "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/change_operation"}}
      }
    }
  }
}
