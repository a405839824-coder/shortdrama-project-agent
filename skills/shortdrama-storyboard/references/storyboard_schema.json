{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shortdrama-storyboard:r10.1-compact-master",
  "title": "R10.1 Chinese Short Drama Compact Storyboard Master",
  "description": "模型只提交一次语义原子；R10-SPC-1正式母版与静态关键帧按需编译。画面内容自然描述动作、表演和精确对白，不显示数字制作时间标记；内部计时注释绑定正文，完整发声规格保留在音色子模板。",
  "type": "object",
  "required": [
    "project_version",
    "schema_version",
    "workflow_profile",
    "prevention_evidence",
    "field_order",
    "source_lock",
    "shots",
    "total_duration"
  ],
  "properties": {
    "project_version": {"const": "V16.3-148-R10-StableRuntime"},
    "schema_version": {"const": "R10.1"},
    "schema_profile": {"const": "compact_master_v1"},
    "workflow_profile": {"const": "R10-PG1"},
    "prevention_evidence": {
      "type": "object",
      "required": [
        "scope_lock",
        "source_ledger",
        "change_lock",
        "cognition_matrix",
        "scene_state_ledger",
        "shot_plan",
        "performance_chains",
        "audio_workflow",
        "audit_layers",
        "repair_history"
      ],
      "properties": {
        "scope_lock": {"type": "object"},
        "source_ledger": {"type": "array", "minItems": 1},
        "change_lock": {"type": "object"},
        "cognition_matrix": {"type": "array", "minItems": 1},
        "scene_state_ledger": {"type": "array", "minItems": 1},
        "adjacent_continuity_audit": {
          "type": "object",
          "required": ["contract", "expected_pair_count", "reviewed_pair_count", "coverage_percent", "ordered_pair_sha256", "pairs"],
          "properties": {
            "contract": {"const": "adjacent-pair-continuity-v1"},
            "expected_pair_count": {"type": "integer", "minimum": 0},
            "reviewed_pair_count": {"type": "integer", "minimum": 0},
            "coverage_percent": {"const": 100},
            "ordered_pair_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "pair_id", "left_shot_id", "right_shot_id", "boundary_type",
                  "left_end_state_sha256", "right_start_state_sha256",
                  "reviewed_fields", "continuity_status", "transition_explanation"
                ],
                "properties": {
                  "pair_id": {"type": "string", "pattern": "^.+->.+$"},
                  "left_shot_id": {"type": "string", "minLength": 1},
                  "right_shot_id": {"type": "string", "minLength": 1},
                  "boundary_type": {"enum": ["same_scene", "scene_cut", "episode_cut"]},
                  "left_end_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "right_start_state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                  "reviewed_fields": {
                    "type": "array",
                    "minItems": 7,
                    "maxItems": 7,
                    "uniqueItems": true,
                    "items": {
                      "enum": ["人物位置", "身体朝向", "视线落点", "手持道具", "门窗状态", "动作进度", "光源方向"]
                    }
                  },
                  "continuity_status": {"enum": ["closed", "explained_transition", "fail_current"]},
                  "transition_explanation": {"type": ["string", "null"]}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "dialogue_adaptation_audit": {
          "type": "object",
          "required": [
            "contract", "scope_episode_ids", "candidate_unit_count", "reviewed_unit_count",
            "adapted_dialogue_count", "conversation_scene_count", "scene_classification_count",
            "coverage_percent", "ordered_entry_sha256", "entries"
          ],
          "properties": {
            "contract": {"const": "source-fact-dialogue-v1"},
            "scope_episode_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^EP\\d{2,}$"}
            },
            "candidate_unit_count": {"type": "integer", "minimum": 0},
            "reviewed_unit_count": {"type": "integer", "minimum": 0},
            "adapted_dialogue_count": {"type": "integer", "minimum": 0},
            "conversation_scene_count": {"type": "integer", "minimum": 0},
            "scene_classification_count": {"type": "integer", "minimum": 0},
            "coverage_percent": {"const": 100},
            "ordered_entry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "source_content_partitions": {
              "type": "array", "minItems": 1,
              "description": "仅采用来源未给内容例外的父段必须完整连续分割；不是作者可自签的来源/语义证明。",
              "items": {"$ref": "#/$defs/source_content_partition"}
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "adaptation_id", "source_ledger_index", "source_unit_id", "source_text",
                  "dialogue_affordance", "treatment", "speaker", "adapted_text",
                  "target_shots", "fact_atoms", "speaker_basis", "authorization",
                  "plot_change", "new_plot_facts", "entailment_status", "adaptation_reason",
                  "scene_semantics", "communication_functions", "exchange_participants",
                  "speech_necessity_basis"
                ],
                "properties": {
                  "treatment": {"enum": ["原文直接对白", "原文事实转化对白", "可视动作", "心理音轨", "合并压缩", "不转对白", "来源未给内容的客观叙述"]},
                  "dialogue_affordance": {"enum": ["必须转对白", "建议转对白", "不宜转对白", "仅未给内容不转对白"]},
                  "entailment_status": {"enum": ["entailed_by_source", "source_event_only_pending_independent"]},
                  "source_content_limit": {"$ref": "#/$defs/source_content_limit"},
                  "scene_semantics": {"enum": ["叙述性会话场景", "混合会话场景", "非会话叙述"]},
                  "communication_functions": {
                    "type": "array",
                    "items": {"enum": ["问答", "劝决", "令应", "报听", "辩核", "证判", "说明", "协商", "拒绝", "其他"]}
                  },
                  "exchange_participants": {"type": "array", "items": {"type": "string"}},
                  "speech_necessity_basis": {"type": "string", "minLength": 1}
                },
                "allOf": [{
                  "if": {"properties": {"treatment": {"const": "来源未给内容的客观叙述"}}, "required": ["treatment"]},
                  "then": {
                    "required": ["source_content_limit"],
                    "properties": {
                      "dialogue_affordance": {"const": "仅未给内容不转对白"},
                      "entailment_status": {"const": "source_event_only_pending_independent"},
                      "scene_semantics": {"enum": ["叙述性会话场景", "混合会话场景"]},
                      "speaker": {"const": ""}, "adapted_text": {"const": ""},
                      "target_shots": {"type": "array", "minItems": 1, "maxItems": 1}
                    }
                  },
                  "else": {"not": {"required": ["source_content_limit"]}}
                }]
              }
            }
          }
        },
        "shot_plan": {"type": "array", "minItems": 1},
        "performance_chains": {"type": "array"},
        "audio_workflow": {
          "type": "object",
          "properties": {
            "timing": {"$ref": "#/$defs/shot_timing"}
          },
          "additionalProperties": true
        },
        "protected_dialogue_fragments": {
          "type": "array",
          "description": "仅保存源文出现身份和半开Unicode字符范围，不复制台词；完整覆盖、顺序、人物和单次消费由源文权威校验。",
          "items": {
            "type": "object",
            "required": ["occurrence_id", "shot_id", "dialogue_index", "char_range"],
            "properties": {
              "occurrence_id": {"type": "string", "minLength": 1},
              "shot_id": {"type": "string", "minLength": 1},
              "dialogue_index": {"type": "integer", "minimum": 0},
              "char_range": {"$ref": "#/$defs/char_range"}
            },
            "additionalProperties": false
          }
        },
        "audit_layers": {"type": "array", "minItems": 8},
        "repair_history": {"type": "array"}
      },
      "additionalProperties": true
    },
    "source_ingestion": {
      "type": "object",
      "description": "仅在小说章节或连续叙事直接转分镜时使用；细粒度门禁由功能验证器执行。",
      "additionalProperties": true
    },
    "chapter_intake": {"type": "object", "additionalProperties": true},
    "chapter_map": {"type": ["object", "array"]},
    "source_mapping": {"type": ["object", "array"]},
    "protected_dialogue": {"type": "array"},
    "cognition_matrix": {"type": ["object", "array"]},
    "scene_state": {"type": ["object", "array"]},
    "coverage": {"type": "object"},
    "anchors": {"type": ["object", "array"]},
    "character_anchors": {"type": ["object", "array"]},
    "scene_anchors": {"type": ["object", "array"]},
    "prop_anchors": {"type": ["object", "array"]},
    "costume_anchors": {"type": ["object", "array"]},
    "project_anchors": {"type": ["object", "array"]},
    "stage_evidence": {"type": "object", "additionalProperties": true},
    "human_review": {"type": "object", "additionalProperties": true},
    "canonical_extension": {
      "type": "object",
      "description": "已登记的兼容扩展容器；不得在根级新增任意字段，也不得嵌套Seedance/i2v/batch/derived/cache状态，递归禁项由功能验证器执行。",
      "additionalProperties": true
    },
    "episode_id": {"type": "string", "minLength": 1},
    "episode": {"type": ["string", "integer"]},
    "分集": {"type": ["string", "integer"]},
    "field_order": {
      "const": [
        "镜头编号",
        "时长",
        "累计时长",
        "功能类型",
        "场景连续性ID",
        "镜头类型",
        "可见主体",
        "空间站位描述",
        "起始状态",
        "机位",
        "运镜方式",
        "画面内容",
        "音色",
        "心理音轨",
        "环境音效",
        "环境动态",
        "光影",
        "光源来源",
        "光源方向",
        "色温倾向",
        "生成限制",
        "转场类型",
        "切镜/转场提示词",
        "参考图锚定",
        "覆盖原文",
        "原文依据类型",
        "原文支撑句"
      ]
    },
    "source_lock": {
      "type": "object",
      "required": ["output_contract", "target_model", "aspect_ratio"],
      "properties": {
        "output_contract": {"const": "R10-SPC-1"},
        "target_model": {"const": "Seedance 2.5"},
        "aspect_ratio": {"const": "9:16"}
      },
      "additionalProperties": true
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/shot"}
    },
    "total_duration": {"type": "number", "minimum": 0}
  },
  "additionalProperties": false,
  "$defs": {
    "source_content_partition": {
      "type": "object", "additionalProperties": false,
      "required": ["partition_id", "source_text", "source_text_sha256", "segments"],
      "properties": {
        "partition_id": {"type": "string", "minLength": 1},
        "source_text": {"type": "string", "minLength": 1},
        "source_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "segments": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["source_ledger_index", "source_unit_id", "char_range", "kind"],
          "properties": {
            "source_ledger_index": {"type": "integer", "minimum": 1},
            "source_unit_id": {"type": "string", "minLength": 1},
            "char_range": {"$ref": "#/$defs/char_range"},
            "kind": {"enum": ["given_dialogue", "protected_dialogue", "event_only", "non_dialogue"]},
            "adaptation_id": {"type": "string", "minLength": 1},
            "protected_occurrence_id": {"type": "string", "minLength": 1}
          },
          "allOf": [{
            "if": {"properties": {"kind": {"const": "protected_dialogue"}}},
            "then": {"required": ["protected_occurrence_id"], "not": {"required": ["adaptation_id"]}},
            "else": {"required": ["adaptation_id"], "not": {"required": ["protected_occurrence_id"]}}
          }]
        }}
      }
    },
    "source_content_limit": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "partition_id", "source_text_sha256", "unprovided_content_kind", "narration", "action"],
      "properties": {
        "contract": {"const": "source-content-limit-v1"},
        "partition_id": {"type": "string", "minLength": 1},
        "source_text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "unprovided_content_kind": {"enum": ["instruction_contents_unstated", "answer_contents_unstated", "apology_contents_unstated", "instruction_receipt_contents_unstated"]},
        "narration": {
          "type": "object", "additionalProperties": false,
          "required": ["shot_id", "field", "text", "field_sha256"],
          "properties": {
            "shot_id": {"type": "string", "pattern": "^EP\\d{2,}-\\d{3,}$"},
            "field": {"const": "心理音轨"}, "text": {"type": "string", "minLength": 1},
            "field_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "action": {
          "type": "object", "additionalProperties": false,
          "required": ["shot_id", "field", "field_sha256"],
          "properties": {
            "shot_id": {"type": "string", "pattern": "^EP\\d{2,}-\\d{3,}$"},
            "field": {"const": "画面内容"},
            "field_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    },
    "char_range": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "integer", "minimum": 0}
    },
    "shot_timing": {
      "type": "object",
      "description": "后台计时证据，不增加27字段母版。只能引用注册profile；候选配置未标定，不能通过自报实测或倍率提高容量。精确范围、事件依赖、阶段和跨镜闭合由timing_model校验。",
      "required": ["contract", "utterances", "events"],
      "properties": {
        "contract": {"const": "shot-timing-v1"},
        "default_profile_id": {"type": "string", "minLength": 1},
        "utterances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "speaker", "source", "segments"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["dialogue", "psychological"]},
              "speaker": {"type": "string", "minLength": 1},
              "source": {
                "type": "object",
                "required": ["shot_id"],
                "properties": {
                  "shot_id": {"type": "string", "minLength": 1},
                  "dialogue_index": {"type": "integer", "minimum": 0},
                  "char_range": {"$ref": "#/$defs/char_range"}
                },
                "additionalProperties": false
              },
              "profile_id": {"type": "string", "minLength": 1},
              "segments": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["shot_id", "start", "end", "char_range"],
                  "properties": {
                    "shot_id": {"type": "string", "minLength": 1},
                    "start": {"type": "number", "minimum": 0},
                    "end": {"type": "number", "exclusiveMinimum": 0},
                    "char_range": {"$ref": "#/$defs/char_range"}
                  },
                  "additionalProperties": false
                }
              },
              "pauses": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": false
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "shot_id", "kind", "start", "end"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "shot_id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["action", "reaction", "hold"]},
              "actor": {"type": "string"},
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "exclusiveMinimum": 0},
              "action": {"type": "string"},
              "after": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "basis": {"type": "string"},
              "trigger": {"type": "object"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "shot": {
      "type": "object",
      "required": [
        "镜头编号",
        "时长",
        "累计时长",
        "功能类型",
        "场景连续性ID",
        "镜头类型",
        "可见主体",
        "空间站位描述",
        "起始状态",
        "机位",
        "运镜方式",
        "画面内容",
        "音色",
        "心理音轨",
        "环境音效",
        "环境动态",
        "光影",
        "光源来源",
        "光源方向",
        "色温倾向",
        "生成限制",
        "转场类型",
        "切镜/转场提示词",
        "参考图锚定",
        "覆盖原文",
        "原文依据类型",
        "原文支撑句"
      ],
      "properties": {
        "shot_uid": {"type": "string", "minLength": 1, "description": "服务端持久化的不可变镜头身份。"},
        "scene_uid": {"type": "string", "minLength": 1},
        "episode_id": {"type": "string", "minLength": 1},
        "picture_timing": {
          "type": "object",
          "additionalProperties": false,
          "description": "内部计时注释；正文不含制作时间标记。按正文SHA256绑定，只能回读计时符号，不能夹带剧情或发出通过结论。",
          "required": [
            "contract",
            "text_sha256",
            "annotations"
          ],
          "properties": {
            "contract": {
              "const": "picture-clock-annotations-v1"
            },
            "text_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "annotations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "offset",
                  "token"
                ],
                "properties": {
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "token": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "镜头编号": {"type": "string", "pattern": "^EP\\d{2}-\\d{3}$", "description": "新写显示编号；稳定身份仍由shot_uid承担。"},
        "时长": {"type": "number", "exclusiveMinimum": 0},
        "累计时长": {"type": "number", "minimum": 0},
        "功能类型": {"type": ["string", "number"]},
        "场景连续性ID": {"type": ["string", "number"]},
        "镜头类型": {"type": ["string", "number"]},
        "可见主体": {"type": ["string", "number"], "description": "THG-06：具名/主要可见人物不超过3人；公共场景普通人物在背景生态层另行记录，不计入主要人物数且不得抢戏。"},
        "空间站位描述": {"type": "string", "minLength": 1, "description": "独立说明空间拓扑、人物相对位置、门窗、道具和画面层次。"},
        "起始状态": {"type": "string", "minLength": 1, "description": "THG-08：只说明镜头开始瞬间的位置、朝向、静态姿态、视线、道具与表演状态；不得预写本镜核心动作或其完成结果。"},
        "机位": {"type": ["string", "number"]},
        "运镜方式": {"type": "string", "minLength": 1, "description": "移动镜头在同一字段写明速度、运镜主体和叙事功能。"},
        "画面内容": {"type": "string", "minLength": 1, "description": "自然描述本镜具体动作、表情、精确对白、口型、视线、听者反应与结束状态，不显示【0.0—0.4秒】等数字制作时间标记，不复制完整音色规格。内部计时通过picture_timing绑定；历史带标记输入仅用于兼容读取，导出时分离计时注释。"},
        "音色": {"type": "string", "minLength": 1, "description": "THG-15：带对白镜按fixed-voice-template-v1固定顺序填写基础声线、言语行为、当前表达、发声方式下六项和2—4项禁止语气；重音逐字来自本镜实际对白。原文直接对白受THG-05逐字保护，原文事实转化对白受THG-16来源证明约束。发声方式是本字段内部空值分组标题，不是顶层字段。无对白时固定写无对白，不适用。"},
        "心理音轨": {"type": ["string", "number"]},
        "环境音效": {"type": ["string", "number"]},
        "环境动态": {"type": ["string", "number"]},
        "光影": {"type": "string", "minLength": 1, "description": "THG-17：主要受光主体、面部明暗、关键道具、高光与暗部材质关系；普通室内还必须明确空气清澈、背景清晰可辨且不泛白不雾化。"},
        "光源来源": {"type": "string", "minLength": 1, "description": "THG-17：按时间、室内外、门窗开合和天气选择唯一主光与弱补光；闭窗日景写窗纸漫射透光，不写光束穿窗射入。"},
        "光源方向": {"type": "string", "minLength": 1, "description": "THG-17：保留画面方向、高度、暗侧补光与纵深衰减；普通室内写前侧/侧面漫射明暗和无可见光束，不得用穿插光线擅改门窗。"},
        "色温倾向": {"type": "string", "minLength": 1, "description": "THG-17：定性暖冷空间关系、肤色与材质本色；禁止Kelvin/K数值、空泛单词和整幅统一染黄/红/蓝。"},
