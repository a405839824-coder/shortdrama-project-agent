HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=https://storyboard-agent.example.com
SHORTDRAMA_DEPLOYMENT_MODE=cloud
SHORTDRAMA_AUTH_MODE=oauth
SHORTDRAMA_DATA_DIR=/data
OAUTH_ISSUER=https://your-tenant.REGION.auth0.com/
OAUTH_AUDIENCE=https://storyboard-agent.example.com
OAUTH_JWKS_URL=https://your-tenant.REGION.auth0.com/.well-known/jwks.json
OAUTH_SCOPES=storyboard:read,storyboard:write
ALLOW_LOCAL_FILE_URLS=0
MAX_FILE_BYTES=52428800
