HOST=0.0.0.0
PUBLIC_BASE_URL=https://YOUR_SERVICE.up.railway.app
SHORTDRAMA_DEPLOYMENT_MODE=cloud
SHORTDRAMA_AUTH_MODE=oauth
SHORTDRAMA_DATA_DIR=/data
# Keep persistent during snapshot registration; switch to library only after
# every project pointer and Library readback has been verified.
SHORTDRAMA_PROJECT_STORAGE_MODE=persistent
OAUTH_ISSUER=https://YOUR_TENANT.REGION.auth0.com/
OAUTH_AUDIENCE=https://YOUR_SERVICE.up.railway.app
OAUTH_JWKS_URL=https://YOUR_TENANT.REGION.auth0.com/.well-known/jwks.json
OAUTH_SCOPES=storyboard:read,storyboard:write
ALLOW_LOCAL_FILE_URLS=0
MAX_FILE_BYTES=52428800
